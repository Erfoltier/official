# 予約カレンダー（ロリポップ用）。このフォルダ（例：/reserve/）に置く

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 設定・プログラム・データの直接表示を禁止
  RewriteRule ^(lib|data|seed)(/|$) - [F,L]
  RewriteRule ^config(\.sample)?\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]

  # API は api/index.php にまとめる
  RewriteRule ^api/v1/ api/index.php [L,QSA]

  # 認証ヘッダーを PHP に渡す（外部連携の Bearer トークン用）
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # http で開かれたら https に転送する場合は、次の2行の先頭の # を外す
  # RewriteCond %{HTTPS} !on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  # 画面のファイルは更新が反映されるよう毎回確認させる（API は PHP 側で no-store）
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
