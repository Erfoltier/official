# 院の入口のBasic認証（ユーザー名:パスワード）
STAFF_BASIC_AUTH=staff:change-me
# スタッフのログイン状態の署名用（32文字以上。例: openssl rand -hex 32）
SESSION_SECRET=
# 保存データの暗号鍵（64桁の16進数。例: openssl rand -hex 32）。紛失するとデータを読めなくなるので別の場所にも控える
DATA_ENCRYPTION_KEY=
# 初回起動時に作る院長アカウントのPIN（4〜8桁、本番のみ。ログイン後にスタッフ画面で変更）
INITIAL_ADMIN_PIN=
# 保存先（既定は ./.data）。RESERVE_DB でファイルを直接指定することもできる
# RESERVE_DATA_DIR=/var/lib/reserve
# デモデータ（架空の患者・予約）を入れるか。未設定なら開発時は入れ、本番では入れない
# RESERVE_DEMO=0
# 外部連携API用のトークン（32文字以上）
INTEGRATION_API_TOKEN=
